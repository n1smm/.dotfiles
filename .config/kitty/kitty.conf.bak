close_on_child_death yes
scrollback_lines 4000
tab_bar_edge bottom
tab_bar_margin_width 0.0
tab_bar_style fade
shell zsh
editor nvim
allow_hyperlinks yes
allow_cloning ask
enable_audio_bell no
enable_layouts splits:split_axis=auto,stack
layout		   splits:split_axis=auto

# Automatically start the background change script
allow_remote_control yes
listen_on unix:@mykitty
#initial_window_command ./kitty_change_bg.sh

# Colors
# background #010a0a
# background #ffffff
# foreground #93672e
background_opacity 0.9
# selection_foreground #ffffff
# selection_background #4c566a
# Set the background image
#background_image /home/thiew/Pictures/animated_wallpapers/empty_bed.png
#background_image_layout scaled
background_image_alignment center
background_image_opacity 0.2
backgroundd_image_tint 0.5
# inactive_border_color #f9ca24
# active_border_color #f78fb3

# Window padding
padding_width 20
padding_height 20

# Cursor
cursor_shape block
cursor_blink yes
cursor_color #ebcb8b

#scrolling
scrollback_lines -1
wheel_scroll_multiplier 3.0
touch_scroll_multiplier 1.0


unmap ctrl+shift+u
unmap ctrl+shift+up
unmap ctrl+shift+down

map kitty_mod+u scroll_to_prompt -1
map kitty_mod+d scroll_to_prompt +1
map kitty_mod+up scroll_page_up
map kitty_mod+down scroll_page_down


kitty_mod ctrl+shift
map kitty_mod+n launch --cwd=current --type=os-window

#create new windows
map kitty_mod+[ launch --location=vsplit --cwd=current
map kitty_mod+] launch --location=hsplit --cwd=current


#custom layouts
# fat layout
# map kitty_mod+1 kitten @ goto-layout fat:bias=80;full_size=1
# map kitty_mod+2 kitten 3_window.py
map kitty_mod+1 kitten new_tab.py 1
map kitty_mod+2 kitten new_tab.py 2
map kitty_mod+3 kitten new_tab.py 3



#neovim integration/ window navigation
map ctrl+j kitten pass_keys.py bottom ctrl+j "^.* - nvim$"
map ctrl+k kitten pass_keys.py top    ctrl+k "^.* - nvim$"
map ctrl+h kitten pass_keys.py left   ctrl+h "^.* - nvim$"
map ctrl+l kitten pass_keys.py right  ctrl+l "^.* - nvim$"

map ctrl+j kitten pass_keys.py bottom ctrl+j
map ctrl+k kitten pass_keys.py top    ctrl+k
map ctrl+h kitten pass_keys.py left   ctrl+h
map ctrl+l kitten pass_keys.py right  ctrl+l

#window resizing
map ctrl+Left  resize_window   narrower   1    # shrink width by 1 cell
map ctrl+Right resize_window   wider      1    # grow   width by 1 cell
map ctrl+Up    resize_window   taller     1    # grow   height by 1 cell
map ctrl+Down  resize_window   shorter    1    # shrink height by 1 cell
map ctrl+Home  resize_window   reset         # reset all splits to even sizes


#history scroll h\l
unmap ctrl+shift+h
map kitty_mod+h send_text all \x1b[A
map kitty_mod+l send_text all \x1b[B


# BEGIN_KITTY_THEME
# Aquarium-Theme
include current-theme.conf
# END_KITTY_THEME
