[global_config]
  tab_position = left
  suppress_multiple_term_dialog = True
[keybindings]
  go_up = <Alt>k
  go_down = <Alt>j
  go_left = <Alt>h
  go_right = <Alt>l
  layout_launcher = <Alt>i
[profiles]
  [[default]]
    background_color = "#17100a"
    background_type = image
    background_image = /home/thiew/Downloads/eye3.jpg
    cursor_fg_color = "#17100a"
    cursor_bg_color = "#c67700"
    cursor_color_default = False
    font = MesloLGS NF 10
    foreground_color = "#c67700"
    scrollback_infinite = True
    palette = "#282828:#cc241d:#98971a:#d79921:#458588:#b16286:#689d6a:#a89984:#928374:#fb4934:#b8bb26:#fabd2f:#83a598:#d3869b:#8ec07c:#ebdbb2"
    use_custom_command = True
    custom_command = /bin/zsh
    use_system_font = False
    title_hide_sizetext = True
    title_transmit_fg_color = "#93672e"
    title_transmit_bg_color = "#486590"
    title_receive_fg_color = "#b19062"
    title_receive_bg_color = "#4a2311"
    title_inactive_fg_color = "#486590"
    title_inactive_bg_color = "#552314"
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = Terminal
      parent = window0
[plugins]
